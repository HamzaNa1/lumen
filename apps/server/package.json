{
  "name": "lumen-server",
  "version": "0.0.27",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/main.ts",
    "start": "bun src/main.ts",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "bun test ../../tests/server ../../tests/shared",
    "db:migrate": "bun src/database/migrate.ts"
  },
  "dependencies": {
    "@effect/platform-bun": "4.0.0-beta.83",
    "@effect/sql-sqlite-bun": "4.0.0-beta.83",
    "@lumen/contracts": "workspace:*",
    "@lumen/database": "workspace:*",
    "drizzle-orm": "1.0.0-rc.4",
    "effect": "4.0.0-beta.83",
    "pino": "10.3.1",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "@types/ws": "8.18.2",
    "typescript": "7.0.2"
  }
}
