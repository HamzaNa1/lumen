{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "jsx": "react-jsx",
    "types": [
      "react",
      "vite/client"
    ],
    "paths": {
      "@lumen/contracts": [
        "../../packages/contracts/src/index.ts"
      ],
      "@lumen/contracts/*": [
        "../../packages/contracts/src/*"
      ],
      "@lumen/client": [
        "../../packages/client/src/index.ts"
      ],
      "@lumen/client/runtime": [
        "../../packages/client/src/runtime.ts"
      ],
      "@lumen/ui": [
        "../../packages/ui/src/index.ts"
      ],
      "@lumen/ui/*": [
        "../../packages/ui/src/*"
      ],
      "@lumen/app": [
        "../../packages/app/src/index.ts"
      ]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "../../packages/app/src/**/*.ts",
    "../../packages/app/src/**/*.tsx"
  ]
}
