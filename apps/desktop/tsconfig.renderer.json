{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["bun"],
    "paths": {
      "@lumen/contracts": ["../../packages/contracts/src/index.ts"],
      "@lumen/contracts/*": ["../../packages/contracts/src/*"],
      "@lumen/ui": ["../../packages/ui/src/index.ts"],
      "@lumen/ui/*": ["../../packages/ui/src/*"]
    }
  },
  "include": ["src/renderer/**/*.ts", "src/renderer/**/*.tsx", "src/preload/**/*.ts", "../../packages/contracts/src/**/*.ts", "../../packages/ui/src/**/*.ts", "../../packages/ui/src/**/*.tsx"]
}
