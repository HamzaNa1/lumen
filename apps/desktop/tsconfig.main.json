{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023"],
    "jsx": "react-jsx",
    "types": ["bun", "node"],
    "paths": {
      "electron": ["./node_modules/electron"],
      "koffi": ["./node_modules/koffi"],
      "@lumen/contracts": ["../../packages/contracts/src/index.ts"],
      "@lumen/contracts/*": ["../../packages/contracts/src/*"]
    }
  },
  "include": ["src/main/**/*.ts", "src/preload/**/*.ts", "scripts/**/*.ts", "electron.vite.config.ts", "../../tests/native/**/*.ts", "../../packages/contracts/src/**/*.ts"]
}
