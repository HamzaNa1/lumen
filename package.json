{
  "name": "lumen",
  "version": "0.0.8",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:server": "bun run --cwd apps/server dev",
    "dev:desktop": "bun run --cwd apps/desktop dev",
    "dev:web": "bun run --cwd apps/web dev",
    "build": "bun run --filter '*' build",
    "build:web": "bun run --cwd apps/web build",
    "typecheck": "bun run --filter '*' typecheck && bun scripts/typecheck.ts -p tsconfig.scripts.json && bun run typecheck:tests",
    "typecheck:tests": "bun scripts/typecheck.ts -p tests/e2e",
    "lint": "biome check .",
    "test": "bun scripts/test-e2e.ts source",
    "test:browser": "bun scripts/test-browser.ts source",
    "check": "bun run lint && bun run typecheck && bun run build && bun run test:coverage",
    "check:server": "bun scripts/check.ts server",
    "check:desktop": "bun scripts/check.ts desktop",
    "db:generate": "bun run --cwd packages/database generate",
    "db:migrate": "bun run --cwd apps/server db:migrate",
    "version:set": "bun scripts/version.ts set",
    "version:check": "bun scripts/version.ts check",
    "backup": "bun apps/server/scripts/backup.ts",
    "test:browser:server": "bun scripts/test-browser.ts server",
    "test:browser:desktop": "bun scripts/test-browser.ts desktop",
    "test:coverage": "bun scripts/e2e-coverage.ts",
    "test:e2e": "bun scripts/test-e2e.ts source"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/plugin-transform-typescript": "7.29.9",
    "@biomejs/biome": "2.5.14",
    "@jridgewell/trace-mapping": "0.3.31",
    "@playwright/test": "1.63.0",
    "@types/babel__core": "7.20.5",
    "@types/bun": "1.4.4",
    "@types/istanbul-lib-instrument": "1.7.8",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "istanbul-lib-instrument": "6.0.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tsrs": "0.18.0-ts7.1.0-dev.20260929",
    "typescript": "7.0.2"
  }
}
