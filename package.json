{
  "name": "lumen",
  "version": "0.0.2",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev:server": "bun run --cwd apps/server dev",
    "dev:desktop": "bun run --cwd apps/desktop dev",
    "build": "bun run --filter '*' build",
    "typecheck": "bun run --filter '*' typecheck",
    "lint": "biome lint .",
    "test": "bun test",
    "check": "bun run lint && bun run typecheck && bun test && bun run build",
    "db:generate": "bun run --cwd packages/database generate",
    "db:migrate": "bun run --cwd apps/server db:migrate",
    "version:set": "bun scripts/version.ts set",
    "version:check": "bun scripts/version.ts check",
    "backup": "bun scripts/backup.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@electron/asar": "3.4.1",
    "@types/bun": "1.4.2",
    "effect": "4.0.0-beta.83",
    "typescript": "7.0.2",
    "yaml": "2.8.2"
  }
}
