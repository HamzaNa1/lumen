{
  "name": "lumen",
  "version": "0.0.8",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.3",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:server": "bun run --cwd apps/server dev",
    "dev:desktop": "bun run --cwd apps/desktop dev",
    "dev:web": "bun run --cwd apps/web dev",
    "build": "bun run --filter '*' build",
    "build:web": "bun run --cwd apps/web build",
    "typecheck": "bun run --filter '*' typecheck && tsc -p tsconfig.scripts.json && bun run typecheck:tests",
    "typecheck:tests": "tsc -p tests/server && tsc -p tests/web && tsc -p tests/desktop && tsc -p tests/shared && tsc -p tests/tooling && tsc -p tests/compatibility && tsc -p tests/browser && tsc -p tests/helpers",
    "lint": "biome lint .",
    "test": "bun test",
    "test:browser": "bun scripts/test-browser.ts source",
    "test:browser:baseline": "bun scripts/test-browser.ts source desktop- --project chromium",
    "check": "bun run lint && bun run typecheck && bun test && bun run build",
    "check:server": "bun scripts/check.ts server",
    "check:desktop": "bun scripts/check.ts desktop",
    "db:generate": "bun run --cwd packages/database generate",
    "db:migrate": "bun run --cwd apps/server db:migrate",
    "version:set": "bun scripts/version.ts set",
    "version:check": "bun scripts/version.ts check",
    "backup": "bun apps/server/scripts/backup.ts",
    "test:browser:server": "bun scripts/test-browser.ts server",
    "test:browser:desktop": "bun scripts/test-browser.ts desktop"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@playwright/test": "1.63.0",
    "@types/bun": "1.4.2",
    "typescript": "7.0.2"
  }
}
