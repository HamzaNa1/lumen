{
  "name": "lumen",
  "version": "0.0.8",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.3",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:server": "bun run --cwd apps/server dev",
    "dev:desktop": "bun run --cwd apps/desktop dev",
    "dev:web": "bun run --cwd apps/web dev",
    "build": "bun run --filter '*' build",
    "build:web": "bun run --cwd apps/web build",
    "typecheck": "bun run --filter '*' typecheck && tsc -p tsconfig.scripts.json",
    "lint": "biome lint .",
    "test": "bun test",
    "test:coverage": "bun scripts/coverage.ts",
    "test:browser": "bun run build:web && bun run --cwd apps/desktop build && bun tests/browser/buildDesktopBaseline.ts && playwright test",
    "test:browser:baseline": "bun run build:web && bun run --cwd apps/desktop build && bun tests/browser/buildDesktopBaseline.ts && playwright test desktop-parity --project chromium",
    "check": "bun run lint && bun run typecheck && bun run test:coverage && bun run build",
    "check:server": "bun scripts/check.ts server",
    "check:desktop": "bun scripts/check.ts desktop",
    "db:generate": "bun run --cwd packages/database generate",
    "db:migrate": "bun run --cwd apps/server db:migrate",
    "version:set": "bun scripts/version.ts set",
    "version:check": "bun scripts/version.ts check",
    "backup": "bun apps/server/scripts/backup.ts"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/plugin-transform-modules-commonjs": "7.29.7",
    "@babel/plugin-transform-typescript": "7.29.9",
    "@biomejs/biome": "2.5.14",
    "@jridgewell/trace-mapping": "0.3.31",
    "@playwright/test": "1.63.0",
    "@types/babel__core": "7.20.5",
    "@types/bun": "1.4.2",
    "@types/istanbul-lib-instrument": "1.7.8",
    "istanbul-lib-instrument": "6.0.3",
    "typescript": "7.0.2"
  }
}
