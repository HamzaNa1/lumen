{
  "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
  "files": {
    "includes": [
      "**",
      "!**/node_modules",
      "!**/dist",
      "!**/out",
      "!**/release",
      "!**/playwright-report",
      "!**/test-results",
      "!bun.lock"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noExplicitAny": "error"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "overrides": [
    {
      "includes": ["tests/**"],
      "plugins": ["./tooling/biome/no-test-delays.grit"]
    },
    {
      "includes": [
        "apps/**",
        "packages/**",
        "scripts/**",
        "!apps/server/src/jellyfin/**",
        "!apps/server/src/Runtime.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/jellyfin", "**/jellyfin/**"],
                    "message": "The Jellyfin API is a removable module: only Runtime.ts registers it, and nothing else in the server imports it."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
