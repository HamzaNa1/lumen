LUMEN_HOST=127.0.0.1
LUMEN_PORT=3210
LUMEN_DATA_DIR=./data
LUMEN_DATABASE_PATH=./data/lumen.sqlite
# Minimum severity for logs on stdout: debug, info, warn, error.
LUMEN_LOG_LEVEL=info
# Readable text by default; use json for log collectors.
LUMEN_LOG_FORMAT=text
LUMEN_FFPROBE_PATH=ffprobe
LUMEN_LIBRARY_WATCH_INTERVAL_MS=60000
# The built web app served at /web. Defaults to apps/web/dist.
# LUMEN_WEB_ROOT=./apps/web/dist
# When the browser session cookie is Secure: auto (follow the request), always, or never.
# LUMEN_COOKIE_SECURE=auto
# Extra origins allowed to use browser sessions, for proxies that rewrite the Host header.
# LUMEN_ALLOWED_ORIGINS=https://media.example
