LUMEN_HOST=127.0.0.1
LUMEN_PORT=3210
LUMEN_DATA_DIR=./data
LUMEN_DATABASE_PATH=./data/lumen.sqlite
# Minimum severity for logs on stdout: debug, info, warn, error.
LUMEN_LOG_LEVEL=info
# Readable text by default; use json for log collectors.
LUMEN_LOG_FORMAT=text
LUMEN_FFPROBE_PATH=ffprobe
LUMEN_LIBRARY_WATCH_INTERVAL_MS=60000
# The built web app served at /web. Defaults to apps/web/dist.
# LUMEN_WEB_ROOT=./apps/web/dist
# When the browser session cookie is Secure: auto (follow the request), always, or never.
# LUMEN_COOKIE_SECURE=auto
# Extra origins allowed to use browser sessions, for proxies that rewrite the Host header.
# LUMEN_ALLOWED_ORIGINS=https://media.example
# Convert incompatible browser media to H264/AAC using FFmpeg; direct play stays unchanged.
LUMEN_TRANSCODING_ENABLED=true
LUMEN_FFMPEG_PATH=ffmpeg
# cpu, nvenc (NVIDIA), or vaapi (Linux Intel/AMD). GPU drivers must be installed.
LUMEN_TRANSCODING_ENCODER=cpu
# Comma-separated NVIDIA indices, or VAAPI render devices. Least-loaded device wins.
LUMEN_TRANSCODING_GPUS=0
LUMEN_TRANSCODING_THREADS=2
LUMEN_TRANSCODING_MAX_JOBS=4
LUMEN_TRANSCODING_GPU_JOBS=2
# Disable software video encoding when only hardware video workloads are permitted.
# VP8/WebM output requires software video encoding.
LUMEN_TRANSCODING_SOFTWARE_VIDEO=true
